# ─────────────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in what you need.
#  .env.local is gitignored — never commit real tokens or API keys.
# ─────────────────────────────────────────────────────────────────────

# Your live domain. Set this in Vercel too (Project → Settings → Environment
# Variables) so canonical URLs, sitemap.xml and social previews are correct.
NEXT_PUBLIC_SITE_URL=https://30amaintenance.com


# ── Instagram sync ───────────────────────────────────────────────────
# Only needed if you use `npm run sync:instagram`. These are used on YOUR
# machine when pulling photos — they are NOT needed in Vercel, because the
# photos get committed to the repo.

# Long-lived access token (60 days). See README → "Option A".
IG_ACCESS_TOKEN=

# Only needed while generating a long-lived token:
IG_SHORT_TOKEN=
IG_APP_SECRET=


# ── Contact form email ───────────────────────────────────────────────
# Set BOTH of these in Vercel for the contact form to deliver mail.
# Free tier at https://resend.com is plenty for a contact form.
# Without them the form shows your email address as a fallback instead.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend:
CONTACT_FROM_EMAIL=website@30amaintenance.com
